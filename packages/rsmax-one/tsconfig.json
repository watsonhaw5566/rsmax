{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "esm",
    "baseUrl": ".",
    "lib": ["es2019", "DOM"],
    "declaration": true,
    "jsx": "react",
    "types": ["@types/node", "@rstest/core/globals"],
    "downlevelIteration": true,
    "paths": {
      "@rsmax/one/api/current": ["src/api/adapters/wechat.ts"]
    }
  },
  "include": ["src/**/*", "typings/**/*"],
  "exclude": ["cjs", "esm"]
}
