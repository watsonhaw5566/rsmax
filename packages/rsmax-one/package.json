{
  "name": "@rsmax/one",
  "version": "1.4.0",
  "description": "Rsmax 小程序多端方案",
  "repository": "git+https://github.com/remaxjs/remax.git",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./esm/index.js",
      "require": "./cjs/index.js",
      "types": "./esm/index.d.ts"
    },
    "./wechat": {
      "import": "./esm/hostComponents/wechat/index.js",
      "require": "./cjs/hostComponents/wechat/index.js",
      "types": "./esm/hostComponents/wechat/index.d.ts"
    },
    "./ali": {
      "import": "./esm/hostComponents/ali/index.js",
      "require": "./cjs/hostComponents/ali/index.js",
      "types": "./esm/hostComponents/ali/index.d.ts"
    },
    "./toutiao": {
      "import": "./esm/hostComponents/toutiao/index.js",
      "require": "./cjs/hostComponents/toutiao/index.js",
      "types": "./esm/hostComponents/toutiao/index.d.ts"
    },
    "./node/wechat": {
      "require": "./cjs/node/wechat/index.js"
    },
    "./node/ali": {
      "require": "./cjs/node/ali/index.js"
    },
    "./node/toutiao": {
      "require": "./cjs/node/toutiao/index.js"
    }
  },
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "typings": "./esm/index.d.ts",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "node ./scripts/postbuild.js",
    "build:cjs": "tsc --module CommonJS --outDir cjs",
    "clean": "rimraf cjs esm tsconfig.tsbuildinfo",
    "test": "rstest run"
  },
  "dependencies": {
    "@rsmax/framework-shared": "workspace:*",
    "@rsmax/runtime": "workspace:*",
    "@rsmax/shared": "workspace:*",
    "memoize-one": "^5.1.1"
  },
  "devDependencies": {
    "@rsmax/types": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-test-renderer": "^18.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "esnext": "./esm/index.js",
  "gitHead": "d2ff644810449152d124a9da76218bcd9fdfff46"
}
