base.wxml: <wxs module="_h">
base.wxml:     var __cache = {};
base.wxml: 
base.wxml:     module.exports = {
base.wxml:         v: function (value) {
base.wxml:             return value == null ? '' : value;
base.wxml:         },
base.wxml: 
base.wxml:         tid: function (type, ancestor) {
base.wxml:             var chain = ancestor || '';
base.wxml:             var key = type + '::' + chain;
base.wxml: 
base.wxml:             var cached = __cache[key];
base.wxml:             if (cached) {
base.wxml:                 return cached;
base.wxml:             }
base.wxml: 
base.wxml:             var count = 0;
base.wxml:             if (chain) {
base.wxml:                 var items = chain.split(',');
base.wxml:                 for (var i = 0; i < items.length; i++) {
base.wxml:                     if (items[i] === type) {
base.wxml:                         count = count + 1;
base.wxml:                     }
base.wxml:                 }
base.wxml:             }
base.wxml: 
base.wxml:             var id = 'REMAX_TPL_' + (1 + count) + '_' + type;
base.wxml:             __cache[key] = id;
base.wxml:             return id;
base.wxml:         },
base.wxml: 
base.wxml:         container: function (tid) {
base.wxml:             return 'REMAX_TPL_' + (tid + 1) + '_CONTAINER';
base.wxml:         }
base.wxml:     };
base.wxml: </wxs>
