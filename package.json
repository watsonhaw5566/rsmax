{
  "version": "0.1.0",
  "private": true,
  "description": "A simple JSX-based WeChat Mini Program framework using Babel",
  "keywords": [
    "wechat",
    "miniprogram",
    "jsx",
    "babel"
  ],
  "license": "MIT",
  "author": "",
  "scripts": {
    "clean:node_modules": "rm -rf node_modules packages/*/node_modules e2e/node_modules",
    "e2e:build": "rsmax build e2e/src -o e2e/dist",
    "e2e:clean": "rsmax clean e2e/dist",
    "e2e:dev": "rsmax dev e2e/src -o e2e/dist",
    "lint": "rslint .",
    "sort-package-json": "pnpx sort-package-json \"./package.json\" \"packages/*/package.json\"",
    "test": "rstest run",
    "test:watch": "rstest"
  },
  "dependencies": {
    "rsmax": "workspace:*"
  },
  "devDependencies": {
    "@rslint/core": "^0.7.2",
    "@rstest/core": "^0.11.4"
  },
  "engines": {
    "node": "^20",
    "pnpm": "^10.0"
  },
  "root": true
}
